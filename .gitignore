# Secrets
.env

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ipynb_checkpoints/

# Data directories (keep .gitkeep, ignore everything else)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/splits/
!data/processed/splits/**

# NLI inference cache (SQLite DBs contain only hashes, but are large and ephemeral)
data/processed/cache/

# Run artifacts (keep .gitkeep, ignore everything else)
runs/*
!runs/.gitkeep

# Exploration outputs
docs/exploration_output.txt
